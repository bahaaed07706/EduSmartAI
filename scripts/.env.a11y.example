# Credentials for scripts/a11y-audit.js — copy to .env.a11y and fill in locally.
# NEVER commit the filled-in file. Values below are placeholders, not accounts.
#
#   cp scripts/.env.a11y.example scripts/.env.a11y
#   set -a && . ./scripts/.env.a11y && set +a      # bash
#   node scripts/a11y-audit.js
#
# Use throwaway accounts on a local or synthetic-data instance only. Never
# point this at an environment holding real student records.

A11Y_BASE=http://127.0.0.1:3007

A11Y_ADMIN_EMAIL=replace-me@example.test
A11Y_ADMIN_PASSWORD=replace-me

A11Y_LECTURER_EMAIL=replace-me@example.test
A11Y_LECTURER_PASSWORD=replace-me

A11Y_STUDENT_EMAIL=replace-me@example.test
A11Y_STUDENT_PASSWORD=replace-me
