# EduSmartAI Frontend - Environment Variables Template
# Copy this file to .env and adjust the API base URL if needed

# Origin only — no trailing slash and no path. The client appends /api/v1.
REACT_APP_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Demo credentials shown on the login screen (optional)
# ---------------------------------------------------------------------------
# Leave these empty and the login page renders no credentials at all. Set them
# on a public demo so an evaluator can sign in without being handed an account
# out of band. The values must match the SEED_*_PASSWORD variables the backend
# was seeded with, or the buttons will fill in a password that does not work.
#
# There is deliberately no admin variable. Assessing the project does not
# require destructive access, and publishing an admin password is how the
# earlier credential leak happened.
REACT_APP_DEMO_STUDENT_EMAIL=
REACT_APP_DEMO_STUDENT_PASSWORD=
REACT_APP_DEMO_LECTURER_EMAIL=
REACT_APP_DEMO_LECTURER_PASSWORD=
